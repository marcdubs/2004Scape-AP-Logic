[label,ladder_to_dwarf_remains]
// AP: vanilla gated this on %mcannon >= ^mcannon_tasked_with_checking_guard_tower and
// answered "You climb up the ladder... but the trap door will not open." until Dwarf
// Cannon reached that stage. The randomizer opens it unconditionally - the tower (and
// whatever the entrance shuffle sends here) has to be reachable without the quest, and
// nothing above the trap door depends on quest state. With the gate gone there is no
// requirement left to run before the override table, so the consult happens at the top
// of [oploc1,ladder] in ladders.rs2 like every other ladder.
~climb_ladder(movecoord(coord(), 0, 1, 0), true);
