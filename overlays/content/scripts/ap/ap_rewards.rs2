// Archipelago quest-completion reward system. See docs/goals-and-checks.md
// "Feature 2". Data lives in ap_rewards.dbtable/.dbrow (same directory); this
// file is the roll + delivery logic, called from a preamble added to
// [proc,send_quest_complete] in the overlaid general/scripts/quests.rs2, and
// exercised directly by the ::apreward / ::apquestcheck test commands below.

// info: custom - NO-OP SHELL (docs/placement-mode.md "Retire the double
// payout"). Quest completion is now ALSO a watched check: every quest's
// progress varp (or varbit, for quest_horror) reaching its completion
// threshold is a `quest_<dirname>` watch in ap-checks.json, so
// ApChecks.onVarpSet already fires the SAME quest-complete moment as a check
// through the normal ApChecks.fireCheck -> [queue,ap_check_fired] path
// (unlock-or-filler, exactly like every other check) - by the time this proc
// runs (called from send_quest_complete, itself called after the quest's
// completion varp write already landed - verified against several quests'
// [queue,*_complete] scripts, e.g. quest_doric.rs2 sets %doricquest before
// calling send_quest_complete, same pattern in quest_cog/quest_horror), the
// watcher has ALREADY fired (enqueued the announce+reward for) this exact
// completion. This holds in BOTH modes: placements
// active (the quest's real payoff IS its placed item, delivered by the
// watcher) and placements absent (the watcher still fires and rolls filler -
// rs2 has no way to see whether ap-placements.json exists, so gating had to
// happen here, engine-side, structurally, not by an if-check). Rolling a
// SECOND reward here on top of the watcher's would double-pay every quest
// completion - kept as a callable no-op (rather than deleting the proc and
// its call site in quests.rs2) so the call site there stays untouched and
// this stays a one-line, obviously-safe revert if the watcher wiring is ever
// pulled out.
[proc,ap_quest_complete]
// intentionally a no-op (return with no reward roll) - see comment above.
return;

// info: custom - the general-purpose check+reward hook, public interface for
// every other check surface (e.g. the checks agent's [queue,ap_check_fired]
// calls this directly). Rolls a weighted random category at the player's level
// in that category and delivers it. Callers must only invoke this from a
// queue-triggered (or otherwise already-protected) context, same guarantee
// ap_quest_complete relies on above.
[proc,ap_grant_check_reward]
~ap_grant_category(~ap_random_category);

// info: custom - named-pack entry point, for real-Archipelago mode. The AP item
// pool ships DISTINCT filler items ("Ore Pack", "Bar Pack", ...) rather than one
// opaque "Mystery Reward", so the multiworld can hint them, the spoiler log
// names them, and a YAML can ask for more of one kind. ApClient.ts resolves the
// received item name to the pack id and passes it through [queue,ap_remote_item]
// to here; the CONTENTS are still rolled locally at receipt time, against the
// stats you have when it lands. An unrecognized (or empty) pack id is the
// "Mystery Reward" case and falls back to the weighted random category, so an
// older server paired with a newer apworld degrades to the old behavior instead
// of dropping the reward.
[proc,ap_grant_named_pack](string $pack)
if (compare($pack, "ore_pack") = 0) {
    ~ap_grant_category("ores");
} else if (compare($pack, "bar_pack") = 0) {
    ~ap_grant_category("bars");
} else if (compare($pack, "herb_pack") = 0) {
    ~ap_grant_category("herbs");
} else if (compare($pack, "rune_pack") = 0) {
    ~ap_grant_category("runes");
} else if (compare($pack, "crafting_runecraft_pack") = 0) {
    ~ap_grant_category("crafting_runecraft");
} else {
    ~ap_grant_check_reward;
}

// Rolls and delivers one reward from $category. "Pack" categories
// (ores/bars/herbs/runes/crafting_runecraft) roll rewardPackRolls times instead of once - each roll
// independently level-biased - so a pack reads like a drop table rather than one
// lonely stack. Identical rolls stack in the inventory on their own, so no
// merging is needed here.
[proc,ap_grant_category](string $category)
if (compare($category, "xp") = 0) {
    ~ap_grant_xp_reward;
    return;
}
if (compare($category, "addons") = 0) {
    if (~ap_try_addon_reward = true) {
        return;
    }
    // every enabled addon already owned (or all disabled) - the slot falls
    // back to a keepsake so the roll is never a dud.
    ~ap_deliver_reward(~ap_roll_reward("keepsakes", 1), "Archipelago reward");
    return;
}
def_int $level = ~ap_level_for_category($category);
def_int $rolls = ~ap_category_rolls($category);
def_string $label = ~ap_category_label($category);
def_int $i = 0;
while ($i < $rolls) {
    ~ap_deliver_reward(~ap_roll_reward($category, $level), $label);
    $i = calc($i + 1);
}

// How many independent rolls a category hands out. Only the five resource packs
// are multi-roll: the rest are single items where three copies would just be
// noise (nobody wants three rune platebodies).
[proc,ap_category_rolls](string $category)(int)
if (compare($category, "ores") = 0 | compare($category, "bars") = 0 | compare($category, "herbs") = 0 | compare($category, "runes") = 0 | compare($category, "crafting_runecraft") = 0) {
    def_int $rolls = ap_option("rewardPackRolls");
    if ($rolls < 1) {
        $rolls = 1;
    }
    return($rolls);
}
return(1);

// Chat prefix for a delivery line. The packs get their own name so a multi-roll
// reward reads as one thing ("Ore Pack: 61 x Coal!" three times over) instead of
// three unrelated "Archipelago reward" lines.
[proc,ap_category_label](string $category)(string)
if (compare($category, "ores") = 0) {
    return("Ore Pack");
} else if (compare($category, "bars") = 0) {
    return("Bar Pack");
} else if (compare($category, "herbs") = 0) {
    return("Herb Pack");
} else if (compare($category, "runes") = 0) {
    return("Rune Pack");
} else if (compare($category, "crafting_runecraft") = 0) {
    return("Crafting & Runecrafting Pack");
}
return("Archipelago reward");

// The addon drop ladder: first enabled-and-not-yet-
// owned item in a fixed power-curve order is delivered. Ownership = inventory
// OR bank (these are untradeable and not equippable, so those are the only two
// places one can live); a dropped/destroyed addon therefore becomes rollable
// again, which is the desired self-healing behavior. The Greater focus only
// rolls once the basic focus is owned (an upgrade that stores 2 locations),
// and both keep working side by side (slot 1 is shared).
// ap_option consults data/config/ap-options.json engine-side.
[proc,ap_try_addon_reward]()(boolean)
if (ap_option("addonBankBox") = 1 & ~ap_addon_owned(ap_bank_box) = false) {
    ~ap_deliver_reward(ap_bank_box, 1, "Archipelago reward");
    return(true);
}
if (ap_option("addonTreeCompass") = 1 & ~ap_addon_owned(ap_tree_compass) = false) {
    ~ap_deliver_reward(ap_tree_compass, 1, "Archipelago reward");
    return(true);
}
if (ap_option("addonTeleportingFocus") = 1) {
    if (~ap_addon_owned(ap_teleporting_focus) = false & ~ap_addon_owned(ap_greater_teleporting_focus) = false) {
        ~ap_deliver_reward(ap_teleporting_focus, 1, "Archipelago reward");
        return(true);
    }
    if (~ap_addon_owned(ap_teleporting_focus) = true & ~ap_addon_owned(ap_greater_teleporting_focus) = false) {
        ~ap_deliver_reward(ap_greater_teleporting_focus, 1, "Archipelago reward");
        return(true);
    }
}
if (ap_option("addonNpcTeleport") = 1 & ~ap_addon_owned(ap_npc_teleport) = false) {
    ~ap_deliver_reward(ap_npc_teleport, 1, "Archipelago reward");
    return(true);
}
return(false);

[proc,ap_addon_owned](namedobj $item)(boolean)
if (inv_total(inv, $item) > 0 | inv_total(bank, $item) > 0) {
    return(true);
}
return(false);

// info: custom - XP-drop reward category (10k-50k real XP in a uniformly
// random skill, all 19 including hitpoints - flat random across all of them
// is the fun, see checks-and-unlocks.md "XP drops"). No dbrows: amount and
// skill are rolled here directly. ap_stat_advance_raw bypasses the world's
// xpRate multiplier so a "10k XP" drop is 10k XP on a 1x world and a 30x
// world alike (engine XP units are tenths of a point).
[proc,ap_grant_xp_reward]
def_stat $stat = enum(int, stat, stats, calc(random(19) + 1));
def_int $exp = calc(random(400001) + 100000);
ap_stat_advance_raw($stat, $exp);
mes("You are struck by inspiration! +<tostring(calc($exp / 10))> <~stat_name($stat)> XP.");

// Weighted category roll for a "roll anything" reward. Was a flat random(16),
// which gave 3-row `caskets` exactly as much airtime as 27-row `armour` and put
// ~19% of every reward you will ever see into melee/ranged gear you have almost
// certainly already out-tiered. Now each category carries a weight from
// ap-options.json (rewardWeight*, see ApOptions.ts NUMERIC_DEFAULTS for the
// defaults and the reasoning) and the roll is proportional to weight - so a
// weight of 0 removes a category outright and the resource packs can carry the
// bulk of the pool without any category being unreachable.
//
// Same single-pass weighted reservoir (A-Chao) as ap_roll_reward: no arrays in
// this script language, so ~ap_weigh_category folds one candidate in at a time
// and hands back the running (choice, total) pair.
[proc,ap_random_category]()(string)
def_string $chosen = "";
def_int $total = 0;
$chosen, $total = ~ap_weigh_category("ores", "rewardWeightOres", $chosen, $total);
$chosen, $total = ~ap_weigh_category("bars", "rewardWeightBars", $chosen, $total);
$chosen, $total = ~ap_weigh_category("herbs", "rewardWeightHerbs", $chosen, $total);
$chosen, $total = ~ap_weigh_category("runes", "rewardWeightRunes", $chosen, $total);
$chosen, $total = ~ap_weigh_category("crafting_runecraft", "rewardWeightCraftingRunecraft", $chosen, $total);
$chosen, $total = ~ap_weigh_category("xp", "rewardWeightXp", $chosen, $total);
$chosen, $total = ~ap_weigh_category("cash", "rewardWeightCash", $chosen, $total);
$chosen, $total = ~ap_weigh_category("food", "rewardWeightFood", $chosen, $total);
$chosen, $total = ~ap_weigh_category("potions", "rewardWeightPotions", $chosen, $total);
$chosen, $total = ~ap_weigh_category("crafting_supplies", "rewardWeightCrafting", $chosen, $total);
$chosen, $total = ~ap_weigh_category("tools", "rewardWeightTools", $chosen, $total);
$chosen, $total = ~ap_weigh_category("runecraft_supplies", "rewardWeightRunecraft", $chosen, $total);
$chosen, $total = ~ap_weigh_category("addons", "rewardWeightAddons", $chosen, $total);
$chosen, $total = ~ap_weigh_category("armour", "rewardWeightArmour", $chosen, $total);
$chosen, $total = ~ap_weigh_category("weapons", "rewardWeightWeapons", $chosen, $total);
$chosen, $total = ~ap_weigh_category("arrows", "rewardWeightArrows", $chosen, $total);
$chosen, $total = ~ap_weigh_category("ranged_gear", "rewardWeightRangedGear", $chosen, $total);
$chosen, $total = ~ap_weigh_category("caskets", "rewardWeightCaskets", $chosen, $total);
$chosen, $total = ~ap_weigh_category("keepsakes", "rewardWeightKeepsakes", $chosen, $total);
if (compare($chosen, "") = 0) {
    // every weight zeroed out - never leave a check unpaid.
    return("keepsakes");
}
return($chosen);

// One reservoir step: fold ($name, weight of $key) into the running selection.
// Weight <= 0 means the category is disabled and is skipped entirely (it never
// enters the total, so it cannot be picked).
[proc,ap_weigh_category](string $name, string $key, string $chosen, int $total)(string, int)
def_int $weight = ap_option($key);
if ($weight <= 0) {
    return($chosen, $total);
}
$total = calc($total + $weight);
if (random($total) < $weight) {
    $chosen = $name;
}
return($chosen, $total);

// The level bias, and the heart of the "drop table" feel. The old rule was a
// HARD cutoff (min_level <= your level, weight = min_level + 1): you could never
// be given something you could not already use, which removed every moment of
// "I can't use this yet, but I will". This replaces it with a tent curve around
// your level, with no cutoff at all:
//
//   * at or below your level - full weight (1000), shedding `rewardObsolescence`
//     per level you are past it, floored at 120 so low tiers keep coming in bulk
//     (you always want coal, at every level).
//   * above your level - halve per `rewardAspirationLevels` levels of overshoot,
//     never below 1. At the default 8, a level-40 smith sees mithril ore at
//     roughly 1 roll in 24, adamantite around 1 in 96, runite around 1 in 400.
//
// Bias, not a rule: everything in the category stays possible at every level.
[proc,ap_tier_weight](int $min_level, int $level)(int)
def_int $gap = calc($level - $min_level);
def_int $weight = 1000;
if ($gap >= 0) {
    def_int $decay = ap_option("rewardObsolescence");
    $weight = calc(1000 - $gap * $decay);
    if ($weight < 120) {
        $weight = 120;
    }
    return($weight);
}
def_int $over = calc(0 - $gap);
def_int $halflife = ap_option("rewardAspirationLevels");
if ($halflife < 1) {
    // defensive: a 0 here would spin forever. ApOptions clamps to >= 1, so this
    // only fires if the option table is ever loaded from somewhere that doesn't.
    $halflife = 1;
}
while ($over > 0 & $weight > 1) {
    $weight = calc($weight / 2);
    $over = calc($over - $halflife);
}
return($weight);

// Maps a reward category to the stat (or %qp, for cash) that gates its tiers.
// "xp" never reaches this (special-cased before the dbtable roll in both
// ap_grant_check_reward and ap_reward_do below).
[proc,ap_level_for_category](string $category)(int)
if (compare($category, "armour") = 0) {
    return(stat_base(defence));
} else if (compare($category, "weapons") = 0) {
    return(stat_base(attack));
} else if (compare($category, "ranged_gear") = 0 | compare($category, "arrows") = 0) {
    return(stat_base(ranged));
} else if (compare($category, "runes") = 0) {
    return(stat_base(magic));
} else if (compare($category, "potions") = 0 | compare($category, "food") = 0) {
    return(stat_base(hitpoints));
} else if (compare($category, "tools") = 0) {
    // gate on the lower of the two gathering stats so a woodcutting-only
    // character can't roll a rune pickaxe (and vice versa)
    return(min(stat_base(woodcutting), stat_base(mining)));
} else if (compare($category, "cash") = 0) {
    return(%qp);
} else if (compare($category, "ores") = 0 | compare($category, "bars") = 0) {
    // Smithing, not Mining: the ore pack exists to feed a smith, and gating on
    // the gathering stat would hand a high-Mining/low-Smithing character ore
    // they can already mine for themselves. Bars are Smithing by definition.
    // min_level on the ore rows is therefore the SMITHING level at which that
    // ore becomes relevant (coal at 30 = steel bars), not its mining level.
    return(stat_base(smithing));
} else if (compare($category, "herbs") = 0) {
    return(stat_base(herblore));
} else if (compare($category, "runecraft_supplies") = 0) {
    return(stat_base(runecraft));
} else if (compare($category, "crafting_supplies") = 0) {
    return(stat_base(crafting));
} else if (compare($category, "crafting_runecraft") = 0) {
    // flat pool - all three rows are min_level 1, so ~ap_tier_weight weights
    // them equally whatever this returns. min() of the two governing stats is
    // the honest mapping (same reasoning as tools) rather than a claim that
    // either skill alone owns the pack.
    return(min(stat_base(crafting), stat_base(runecraft)));
} else if (compare($category, "caskets") = 0) {
    // trail reward caskets (the user-requested "junk casket" filler - see
    // checks-and-unlocks.md "Treasure Trails"). Tiered on hitpoints as an
    // overall-progress proxy, same reasoning as potions/food: a fresh account
    // rolls easy caskets, a developed one can also roll medium/hard.
    return(stat_base(hitpoints));
} else if (compare($category, "keepsakes") = 0) {
    // flat pool - every keepsakes row is min_level 1, so ~ap_tier_weight hands
    // every row the same weight and the roll is uniform across the whole
    // category regardless of what we return here. No level gating is
    // appropriate for one-per-account quest keepsakes, so this is a deliberate
    // neutral mapping, not an oversight.
    return(1);
}
return(1);

// Weighted roll among EVERY ap_rewards row in $category - there is no
// eligibility filter any more, only the ~ap_tier_weight bias, so a tier above
// your level is rare rather than impossible.
// Single-pass weighted reservoir sampling (A-Chao): after folding in each
// row, keep it with probability weight/running_total - this is exactly
// proportional-to-weight selection without needing an array to collect
// candidates first (this script language has none).
// Quantity is a uniform roll in [qty, qty_max] so repeat rewards of the same
// item still feel different; qty_max < qty (a bad hand edit) degrades to the
// fixed qty rather than a negative random() argument.
[proc,ap_roll_reward](string $category, int $level)(namedobj, int)
def_namedobj $chosen_item = null;
def_int $chosen_qty = 0;
def_int $total_weight = 0;

db_find(ap_rewards:category, $category);
def_dbrow $row = db_findnext;
while ($row ! null) {
    def_int $weight = ~ap_tier_weight(db_getfield($row, ap_rewards:min_level, 0), $level);
    $total_weight = calc($total_weight + $weight);
    if (random($total_weight) < $weight) {
        $chosen_item = db_getfield($row, ap_rewards:reward, 0);
        def_int $qty_min = db_getfield($row, ap_rewards:qty, 0);
        def_int $qty_max = db_getfield($row, ap_rewards:qty_max, 0);
        if ($qty_max < $qty_min) {
            $qty_max = $qty_min;
        }
        $chosen_qty = calc($qty_min + random(calc($qty_max - $qty_min + 1)));
    }
    $row = db_findnext;
}
return($chosen_item, $chosen_qty);

// Delivery: inventory first, bank fallback on a full inventory, never the
// ground (a pattern already used by e.g.
// quest_legends.rs2). Requires protected access when the bank branch is hit -
// callers that don't already have it (debugproc test commands) must acquire
// it first via the usual if_close/p_finduid dance.
//
// Bug fix (2026-07-16, user report: "AP rewards are dropping to the ground when
// inventory is full"): the old condition `inv_freespace(inv) > 0 |
// inv_total(inv, $item) > 0` treated "already carrying one of these" as proof a
// new copy will fit, which is only true for STACKABLE items (a second stack entry
// needs no new slot). For a non-stackable reward (nearly everything in the
// weapons/armour/ranged_gear/tools categories) that already occupies a slot, a
// genuinely full inventory has nowhere to put a second one - inv_add(inv, ...)
// then has nothing to do but drop it on the ground, which is exactly the
// ground-drop the user saw. Gate the stack-fits-without-a-slot case behind
// oc_stackable so non-stackables only take the inventory branch when a slot is
// actually free.
//
// Bug fix 2 (2026-07-17, user report: 25x rune essence with a partly-full
// inventory - some landed, the rest hit the floor): "a slot is actually free"
// is not enough for a MULTI-QTY non-stackable reward (blankrune x25, potions
// x3, ...) - inv_add fills whatever slots exist and ground-drops the
// remainder, and the bank branch was never reached because freespace was > 0.
// The inventory branch now requires room for the WHOLE quantity
// (freespace >= qty for non-stackables); anything short of that banks the
// entire reward instead of splitting. Bank overflow is not handled by design:
// bank.inv is stackall (240 distinct slots), so a full bank means 240 distinct
// item types - not a state worth code here.
//
// $label is the chat prefix (~ap_category_label): "Archipelago reward" for the
// single-item categories, "Ore Pack" / "Bar Pack" / ... for the multi-roll
// resource packs, so a three-roll pack reads as one reward rather than three
// unrelated ones.
[proc,ap_deliver_reward](namedobj $item, int $qty, string $label)
if ($item = null) {
    mes("AP: no reward available for that roll.");
    return;
}
if ($qty < 1) {
    $qty = 1;
}
def_boolean $fits = false;
if (oc_stackable($item) = true) {
    if (inv_freespace(inv) > 0 | inv_total(inv, $item) > 0) {
        $fits = true;
    }
} else if (inv_freespace(inv) >= $qty) {
    $fits = true;
}
if ($fits = true) {
    inv_add(inv, $item, $qty);
    mes("<$label>: <tostring($qty)> x <oc_name($item)>!");
} else {
    inv_add(bank, $item, $qty);
    mes("<$label>: <tostring($qty)> x <oc_name($item)> (no inventory space, sent to your bank)!");
}

// ::apreward [category] [level] - bare = weighted random category + the
// player's own level in that category (same roll a filler check would make);
// with args, forces category/tier so every level bracket can be eyeballed
// without playing to it. Valid category names: ores, bars, herbs, runes,
// armour, weapons, ranged_gear, arrows, potions, food, tools, cash, xp,
// runecraft_supplies, crafting_supplies, crafting_runecraft, caskets, addons,
// keepsakes - an unrecognized name matches no rows and prints
// ap_deliver_reward's "no reward available" message. xp ignores $level entirely (it's not tiered - see
// ap_grant_xp_reward); keepsakes ignores $level too (flat pool). A $level of 0
// or less means 99, so `::apreward ores 0` shows the top of the curve; pass a
// real level (`::apreward ores 40`) to see the bias a level-40 smith gets,
// including the rare over-level rolls the old hard cutoff made impossible.
[debugproc,ap_reward](string $category, int $level)
if_close;
if (p_finduid(uid) = false) {
    queue*(ap_reward_queue, 0)($category, $level);
    return;
}
~ap_reward_do($category, $level);

[queue,ap_reward_queue](string $category, int $level)
~ap_reward_do($category, $level);

[proc,ap_reward_do](string $category, int $level)
if (compare($category, "") = 0) {
    ~ap_grant_check_reward;
    return;
}
if (compare($category, "xp") = 0) {
    ~ap_grant_xp_reward;
    return;
}
if (compare($category, "addons") = 0) {
    if (~ap_try_addon_reward = false) {
        mes("AP: all enabled addon items already owned (or all addons disabled).");
    }
    return;
}
if ($level <= 0) {
    $level = 99;
}
// same multi-roll treatment the live path gives packs, so ::apreward ores
// shows what a real Ore Pack looks like rather than one lonely stack.
def_int $rolls = ~ap_category_rolls($category);
def_string $label = ~ap_category_label($category);
def_int $i = 0;
while ($i < $rolls) {
    ~ap_deliver_reward(~ap_roll_reward($category, $level), $label);
    $i = calc($i + 1);
}

// ::apquestcheck - fires the quest-completion check+reward path
// (~ap_quest_complete, the same proc send_quest_complete calls) directly, so
// it can be exercised without finishing a quest.
[debugproc,ap_questcheck]
if_close;
if (p_finduid(uid) = false) {
    queue(ap_questcheck_queue, 0, 0);
    return;
}
~ap_quest_complete;

[queue,ap_questcheck_queue]
~ap_quest_complete;
